{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            { "type": "TextBlock", "text": "🔥", "size": "ExtraLarge" }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "Slagio", "weight": "Bolder", "size": "Medium", "spacing": "None" },
            { "type": "TextBlock", "text": "Streak: ${streak} dagen", "spacing": "None", "isSubtle": true }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "⏳ Nog ${examDays} dagen tot ${examVak}",
      "wrap": true,
      "spacing": "Small"
    }
  ],
  "actions": [
    { "type": "Action.OpenUrl", "title": "Oefenen", "url": "/?start=quiz" }
  ]
}
